{
  "name": "pro-short",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "analyze": "python3 tools/build_audio.py",
    "draft": "remotion render src/index.ts Main out/draft.mp4 --scale=0.5 --concurrency=4 --muted --props='{\"lite\":true}' --browser-executable=/opt/pw-browsers/chromium_headless_shell-1194/chrome-linux/headless_shell",
    "final": "python3 tools/render_chunks.py",
    "mix": "python3 tools/make_sfx.py && tools/mix.sh out/silent.mp4 out/final.mp4"
  },
  "dependencies": {
    "@react-three/fiber": "^8.15.19",
    "@remotion/cli": "4.0.235",
    "@remotion/renderer": "4.0.235",
    "@remotion/three": "^4.0.235",
    "@types/three": "^0.160.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.235",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@types/react": "18.3.3",
    "typescript": "5.5.4"
  }
}