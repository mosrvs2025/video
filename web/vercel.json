{
  "cleanUrls": true,
  "headers": [
    { "source": "/media/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=3600" }, { "key": "Accept-Ranges", "value": "bytes" } ] },
    { "source": "/data/(.*)",  "headers": [ { "key": "Cache-Control", "value": "public, max-age=60" } ] }
  ]
}
